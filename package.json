{
  "name": "@local/dsh-grok-xai",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Sign in to xAI with a SuperGrok or X Premium subscription and use Grok models in DeepSeek Harness.",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "grok",
    "xai",
    "supergrok",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuDouPn/dsh-grok-xai.git"
  },
  "homepage": "https://github.com/TuDouPn/dsh-grok-xai#readme",
  "bugs": {
    "url": "https://github.com/TuDouPn/dsh-grok-xai/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs/*.md",
    "docs/images/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
